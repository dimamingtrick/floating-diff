{
  "name": "gitstorm",
  "displayName": "GitStorm",
  "description": "WebStorm-style Git: diffs in a floating window, branches popup, Git Log with a graph, browse branches without checkout, GitStorm panel.",
  "version": "0.4.0",
  "publisher": "DimaShraho",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimamingtrick/floating-diff.git"
  },
  "bugs": {
    "url": "https://github.com/dimamingtrick/floating-diff/issues"
  },
  "keywords": [
    "git",
    "webstorm",
    "jetbrains",
    "git log",
    "git graph",
    "branches",
    "diff",
    "file history"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitStorm.openScmResource",
        "title": "Open Diff in Floating Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitStorm.pickChange",
        "title": "Open Change…",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.close",
        "title": "Close Diff Window",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.branches",
        "title": "Branches…",
        "category": "GitStorm",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitStorm.log",
        "title": "Git Log",
        "category": "GitStorm",
        "icon": "$(history)"
      },
      {
        "command": "gitStorm.fileHistory",
        "title": "File History",
        "category": "GitStorm",
        "icon": "$(history)"
      },
      {
        "command": "gitStorm.browseBranch",
        "title": "Browse Branch…",
        "category": "GitStorm",
        "icon": "$(eye)"
      },
      {
        "command": "gitStorm.fetch",
        "title": "Fetch",
        "category": "GitStorm",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitStorm.changes.open",
        "title": "Open Changes",
        "category": "GitStorm",
        "icon": "$(compare-changes)"
      },
      {
        "command": "gitStorm.changes.openFile",
        "title": "Open File",
        "category": "GitStorm",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitStorm.changes.stage",
        "title": "Stage Changes",
        "category": "GitStorm",
        "icon": "$(add)"
      },
      {
        "command": "gitStorm.changes.unstage",
        "title": "Unstage Changes",
        "category": "GitStorm",
        "icon": "$(remove)"
      },
      {
        "command": "gitStorm.changes.discard",
        "title": "Discard Changes",
        "category": "GitStorm",
        "icon": "$(discard)"
      },
      {
        "command": "gitStorm.changes.ignore",
        "title": "Add to .gitignore",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.changes.reveal",
        "title": "Reveal in Explorer View",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.changes.viewGroup",
        "title": "View Changes",
        "category": "GitStorm",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitStorm.changes.stageAll",
        "title": "Stage All Changes",
        "category": "GitStorm",
        "icon": "$(add)"
      },
      {
        "command": "gitStorm.changes.unstageAll",
        "title": "Unstage All Changes",
        "category": "GitStorm",
        "icon": "$(remove)"
      },
      {
        "command": "gitStorm.changes.discardAll",
        "title": "Discard All Changes",
        "category": "GitStorm",
        "icon": "$(discard)"
      },
      {
        "command": "gitStorm.changes.refresh",
        "title": "Refresh",
        "category": "GitStorm",
        "icon": "$(refresh)"
      },
      {
        "command": "gitStorm.toggleBranches",
        "title": "Show or Hide Branches",
        "category": "GitStorm",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitStorm.viewAsTree",
        "title": "View as Tree",
        "category": "GitStorm",
        "icon": "$(list-tree)"
      },
      {
        "command": "gitStorm.viewAsList",
        "title": "View as List",
        "category": "GitStorm",
        "icon": "$(list-flat)"
      },
      {
        "command": "gitStorm.logInEditor",
        "title": "Git Log in Editor",
        "category": "GitStorm",
        "icon": "$(history)"
      },
      {
        "command": "gitStorm.commit.copyHash",
        "title": "Copy Revision Number",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.openDiff",
        "title": "Open Diff",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.cherryPick",
        "title": "Cherry-Pick",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.checkout",
        "title": "Checkout Revision",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.merge",
        "title": "Merge into Current Branch",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.rebase",
        "title": "Rebase Current Branch onto This Commit",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.revert",
        "title": "Revert Commit",
        "category": "GitStorm"
      },
      {
        "command": "gitStorm.commit.newBranch",
        "title": "New Branch…",
        "category": "GitStorm"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitStorm",
          "title": "GitStorm",
          "icon": "media/gitstorm.svg"
        }
      ],
      "panel": [
        {
          "id": "gitStormBranches",
          "title": "Branches",
          "icon": "media/gitstorm.svg"
        }
      ]
    },
    "views": {
      "gitStorm": [
        {
          "type": "webview",
          "id": "gitStorm.sidebar",
          "name": "GitStorm"
        },
        {
          "id": "gitStorm.badge",
          "name": "GitStorm",
          "when": "false"
        }
      ],
      "gitStormBranches": [
        {
          "type": "webview",
          "id": "gitStorm.branchesPanel",
          "name": "Log"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gitStorm.fileHistory",
          "when": "resourceScheme =~ /^(file|git)$/ && gitOpenRepositoryCount != 0",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gitStorm.openScmResource",
          "when": "false"
        },
        {
          "command": "gitStorm.fileHistory",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitStorm.close",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.open",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.openFile",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.stage",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.unstage",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.discard",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.ignore",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.reveal",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.viewGroup",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.stageAll",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.unstageAll",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.discardAll",
          "when": "false"
        },
        {
          "command": "gitStorm.changes.refresh",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.copyHash",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.openDiff",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.cherryPick",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.checkout",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.merge",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.rebase",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.revert",
          "when": "false"
        },
        {
          "command": "gitStorm.commit.newBranch",
          "when": "false"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitStorm.openScmResource",
          "group": "inline",
          "when": "scmProvider == git && scmResourceGroup =~ /^(index|workingTree|untracked)$/"
        }
      ],
      "view/title": [
        {
          "command": "gitStorm.fetch",
          "when": "view == gitStorm.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "gitStorm.log",
          "when": "view == gitStorm.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "gitStorm.viewAsTree",
          "when": "view == gitStorm.sidebar && gitStorm.changesViewMode == list",
          "group": "navigation@3"
        },
        {
          "command": "gitStorm.viewAsList",
          "when": "view == gitStorm.sidebar && gitStorm.changesViewMode == tree",
          "group": "navigation@3"
        },
        {
          "command": "gitStorm.changes.refresh",
          "when": "view == gitStorm.sidebar",
          "group": "1_refresh"
        },
        {
          "command": "gitStorm.fetch",
          "when": "view == gitStorm.branchesPanel",
          "group": "navigation@1"
        },
        {
          "command": "gitStorm.log",
          "when": "view == gitStorm.branchesPanel",
          "group": "navigation@2"
        },
        {
          "command": "gitStorm.viewAsTree",
          "when": "view == gitStorm.sidebar && gitStorm.changesViewMode == list",
          "group": "2_view@1"
        },
        {
          "command": "gitStorm.viewAsList",
          "when": "view == gitStorm.sidebar && gitStorm.changesViewMode == tree",
          "group": "2_view@1"
        }
      ],
      "webview/context": [
        {
          "command": "gitStorm.changes.open",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(merge|index|workingTree|untracked)$/",
          "group": "navigation@1"
        },
        {
          "command": "gitStorm.changes.openFile",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(merge|index|workingTree|untracked)$/",
          "group": "navigation@2"
        },
        {
          "command": "gitStorm.changes.stage",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(merge|workingTree|untracked)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.unstage",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(index)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.discard",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(workingTree|untracked)$/",
          "group": "1_modification@2"
        },
        {
          "command": "gitStorm.changes.ignore",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(workingTree|untracked)$/ && gitStorm.scmResources",
          "group": "1_modification@3"
        },
        {
          "command": "gitStorm.changes.reveal",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'change' && gitStormGroup =~ /^(merge|index|workingTree|untracked)$/",
          "group": "2_view@1"
        },
        {
          "command": "gitStorm.changes.viewGroup",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeGroup' && gitStormGroup =~ /^(index|workingTree|untracked)$/",
          "group": "navigation@1"
        },
        {
          "command": "gitStorm.changes.stageAll",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeGroup' && gitStormGroup =~ /^(merge|workingTree|untracked)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.unstageAll",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeGroup' && gitStormGroup =~ /^(index)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.discardAll",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeGroup' && gitStormGroup =~ /^(workingTree|untracked)$/",
          "group": "1_modification@2"
        },
        {
          "command": "gitStorm.changes.stage",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeFolder' && gitStormGroup =~ /^(merge|workingTree|untracked)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.unstage",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeFolder' && gitStormGroup =~ /^(index)$/",
          "group": "1_modification@1"
        },
        {
          "command": "gitStorm.changes.discard",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeFolder' && gitStormGroup =~ /^(workingTree|untracked)$/",
          "group": "1_modification@2"
        },
        {
          "command": "gitStorm.changes.ignore",
          "when": "webviewId == 'gitStorm.sidebar' && webviewSection == 'changeFolder' && gitStormGroup =~ /^(workingTree|untracked)$/ && gitStorm.scmResources",
          "group": "1_modification@3"
        },
        {
          "command": "gitStorm.commit.copyHash",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "1_copy@1"
        },
        {
          "command": "gitStorm.commit.openDiff",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "2_open@1"
        },
        {
          "command": "gitStorm.commit.cherryPick",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "3_commit@1"
        },
        {
          "command": "gitStorm.commit.checkout",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "3_commit@2"
        },
        {
          "command": "gitStorm.commit.merge",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "3_commit@3"
        },
        {
          "command": "gitStorm.commit.rebase",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "3_commit@4"
        },
        {
          "command": "gitStorm.commit.revert",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "3_commit@5"
        },
        {
          "command": "gitStorm.commit.newBranch",
          "when": "(webviewId == 'gitStorm.branchesPanel' || webviewId == 'gitStorm.log') && webviewSection == 'commit'",
          "group": "4_new@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitStorm.pickChange",
        "key": "ctrl+alt+d"
      },
      {
        "command": "gitStorm.close",
        "key": "escape",
        "when": "gitStorm.diffFocused && isAuxiliaryWindow && !findWidgetVisible && !suggestWidgetVisible && !parameterHintsVisible && !renameInputVisible && !referenceSearchVisible && !inSnippetMode && !inlineSuggestionVisible && !editorHasSelection && !editorHasMultipleSelections && !editorHoverVisible && !notificationToastsVisible && !inQuickOpen && !accessibleViewIsShown"
      }
    ],
    "configuration": {
      "title": "GitStorm",
      "properties": {
        "gitStorm.openFromSourceControl": {
          "type": "boolean",
          "default": true,
          "description": "Clicking a file in Source Control opens it in the floating window, like the window icon. Relies on internals of the built-in Git extension: if a VS Code update changes them, clicks open tabs as usual."
        }
      }
    }
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . && tsc -p webview && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "tsc -p . && mocha",
    "test:integration": "npm run compile && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "vscode:prepublish": "tsc -p . --noEmit && tsc -p webview && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "preview": "npm run compile && node webview/preview/make-mock-data.mjs && node webview/preview/serve.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.105.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "preact": "^10.29.8"
  }
}
